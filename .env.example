# URL pública do site (canonical, sitemap, robots, Open Graph e QR code).
# Sem barra no final. É embutida no build: defina antes de `npm run build`.
NEXT_PUBLIC_SITE_URL=https://www.menuqr.app

# Modo demonstração: sem DATABASE_URL a aplicação roda inteira no navegador
# (contas e cardápio em localStorage), para testar sem infraestrutura.
# '1' força demonstração, '0' força o backend real. Deixe vazio para automático.
NEXT_PUBLIC_DEMO_MODE=

# Banco de dados.
# Desenvolvimento: arquivo SQLite local (padrão quando a variável não existe).
DATABASE_URL=file:./data/menuqr.db
# Produção com libSQL/Turso:
# DATABASE_URL=libsql://seu-banco.turso.io
# DATABASE_AUTH_TOKEN=

# Código de verificação do Google Search Console (opcional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Login do painel, pelo Clerk. Sem as duas chaves a aplicação cai no modo
# demonstração (conta no navegador) — e no modo demonstração o Clerk nem carrega.
# As chaves estão em https://dashboard.clerk.com → API keys, ou rode `clerk init`.
# A pública também alimenta a CSP em next.config.ts: o endereço da API do Clerk
# sai dela, então dá para trocar de instância sem mexer na política.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Telas do Clerk nas rotas em português. Precisam bater com as pastas
# src/app/(plataforma)/entrar e /criar-conta.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/criar-conta
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/painel
# Conta nova cai no cadastro do restaurante, não no painel vazio.
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/painel/comecar
