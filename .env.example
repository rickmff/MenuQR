# URL pública do site (canonical, sitemap, robots, Open Graph e QR code).
# Sem barra no final. É embutida no build: defina antes de `npm run build`.
NEXT_PUBLIC_SITE_URL=https://www.menuqr.app

# Modo demonstração: sem DATABASE_URL a aplicação roda inteira no navegador
# (contas e cardápio em localStorage), para testar sem infraestrutura.
# '1' força demonstração, '0' força o backend real. Deixe vazio para automático.
NEXT_PUBLIC_DEMO_MODE=

# Banco de dados.
# Desenvolvimento: arquivo SQLite local (padrão quando a variável não existe).
DATABASE_URL=file:./data/menuqr.db
# Produção com libSQL/Turso:
# DATABASE_URL=libsql://seu-banco.turso.io
DATABASE_AUTH_TOKEN=

# Código de verificação do Google Search Console (opcional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Login do painel, pelo Clerk. O modo real (com DATABASE_URL) exige as duas
# chaves: sem elas o build para e diz o que falta. No modo demonstração o Clerk
# nem carrega. As chaves estão em https://dashboard.clerk.com → API keys, ou
# rode `clerk init`. A pública também alimenta a CSP em next.config.ts: o
# endereço da API do Clerk sai dela, então dá para trocar de instância sem
# mexer na política.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook do Clerk (user.updated, user.deleted), apontando para
# /api/webhooks/clerk. O segredo aparece ao cadastrar o endpoint no dashboard.
CLERK_WEBHOOK_SIGNING_SECRET=

# Telas do Clerk nas rotas em português. Precisam bater com as pastas
# src/app/(plataforma)/entrar e /criar-conta.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/criar-conta
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/painel
# Conta nova vai pagar a assinatura antes de cadastrar o restaurante.
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/painel/assinatura

# Rota de limpeza diária (/api/cron/limpeza): a Vercel manda este valor no
# header quando a variável existe. Gere com: openssl rand -hex 32
CRON_SECRET=

# Cobrança da assinatura (Asaas, Pix). Sem ASAAS_API_KEY ninguém consegue
# assinar, e sem assinatura o painel não abre. Para rodar sem cobrança
# (desenvolvimento, instalação própria): BILLING_MODE=off.
BILLING_MODE=asaas
# sandbox | production — são contas separadas no Asaas, com chaves separadas.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# O mesmo token cadastrado no webhook do Asaas (header asaas-access-token).
# Gere com: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=

# Painel de super admin (/admin): e-mails separados por vírgula. Vale o e-mail
# principal da conta no Clerk, e só depois de verificado. Vazio, o /admin não
# abre para ninguém (responde 404).
SUPER_ADMIN_EMAILS=
