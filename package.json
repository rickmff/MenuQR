{
  "name": "menuqr",
  "version": "1.0.0",
  "private": true,
  "description": "Cardapio digital com delivery e pedidos finalizados no WhatsApp",
  "scripts": {
    "dev": "next dev",
    "dev:prod": "set -a && . ./.env.prod.local && set +a && next dev --experimental-https --experimental-https-key certificates/localhost-key.pem --experimental-https-cert certificates/localhost.pem -H 0.0.0.0 -p 443",
    "webhooks:local": "set -a && . ./.env.prod.local && set +a && NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" clerk webhooks listen --token \"$CLERK_WEBHOOK_RELAY_TOKEN\" --forward-to https://local.menuonline.site/api/webhooks/clerk",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types --no-warnings --import ./scripts/lib/register.mjs scripts/migrate.mjs",
    "db:seed": "node --experimental-strip-types --no-warnings --import ./scripts/lib/register.mjs scripts/seed.mjs",
    "db:reset": "rm -f data/menuqr.db data/menuqr.db-shm data/menuqr.db-wal && npm run db:seed",
    "fotos:exemplo": "node --env-file-if-exists=.env.local scripts/fotos-exemplo.mjs",
    "check:exemplo": "node --experimental-strip-types --no-warnings --import ./scripts/lib/register.mjs scripts/check-exemplo.mjs",
    "check:cascata": "node --experimental-strip-types --no-warnings --import ./scripts/lib/register.mjs scripts/check-cascade.mjs",
    "check:assinatura": "node --experimental-strip-types --no-warnings --import ./scripts/lib/register.mjs scripts/check-assinatura.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:exemplo && npm run check:cascata && npm run check:assinatura"
  },
  "dependencies": {
    "@clerk/localizations": "^4.17.1",
    "@clerk/nextjs": "^7.9.4",
    "@libsql/client": "^0.17.4",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "next-intl": "^4.14.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
